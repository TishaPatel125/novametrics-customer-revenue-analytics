PROJECT_NAME="NovaMetrics Customer Intelligence"
API_V1_STR="/api/v1"
SECRET_KEY="temporary-dev-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL: uses SQLite for instant local zero-config, or PostgreSQL for Docker/Prod
DATABASE_URL="sqlite:///./novametrics.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://novametrics_user:novametrics_pass@localhost:5432/novametrics_db"

# Admin default user for demo login
ADMIN_EMAIL="admin@novametrics.io"
ADMIN_PASSWORD="admin_secure_password"
